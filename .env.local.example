# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key - safe to expose to the browser, RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret "service_role" key - server-only, never prefix with NEXT_PUBLIC_.
# Used only to delete staff accounts (auth.admin.deleteUser).
SUPABASE_SERVICE_ROLE_KEY=
